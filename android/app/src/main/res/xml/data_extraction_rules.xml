<?xml version="1.0" encoding="utf-8"?>
<!-- The ledger is local and stays local: never back it up to the cloud and
     never hand it to a device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
